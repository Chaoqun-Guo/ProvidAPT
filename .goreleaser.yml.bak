# ── Goreleaser Configuration ──────────────────────────────────
# Build and release ProvidAPT binaries for multiple platforms.
#
# Usage:
#   goreleaser release --snapshot --clean
#   goreleaser release --clean
#
# Environment variables:
#   GORELEASER_CURRENT_TAG — set by CI (git tag)

version: 2

project_name: providapt

before:
  hooks:
    - go mod tidy
    - go vet ./...

builds:
  - id: providaptd
    main: ./cmd/agent/daemon
    binary: providaptd
    flags:
      - -trimpath
    ldflags:
      - -s -w
      - -X github.com/Chaoqun-Guo/ProvidAPT/internal/version.Version={{ .Version }}
      - -X github.com/Chaoqun-Guo/ProvidAPT/internal/version.Commit={{ .ShortCommit }}
      - -X github.com/Chaoqun-Guo/ProvidAPT/internal/version.Date={{ .Date }}
    env:
      - CGO_ENABLED=0
    goos:
      - linux
    goarch:
      - amd64
      - arm64

  - id: providaptctl
    main: ./cmd/cli/providaptctl
    binary: providaptctl
    flags:
      - -trimpath
    ldflags:
      - -s -w
      - -X github.com/Chaoqun-Guo/ProvidAPT/internal/version.Version={{ .Version }}
      - -X github.com/Chaoqun-Guo/ProvidAPT/internal/version.Commit={{ .ShortCommit }}
      - -X github.com/Chaoqun-Guo/ProvidAPT/internal/version.Date={{ .Date }}
    env:
      - CGO_ENABLED=0
    goos:
      - linux
      - darwin
    goarch:
      - amd64
      - arm64

  - id: providapt-verify
    main: ./cmd/cli/providapt-verify
    binary: providapt-verify
    flags:
      - -trimpath
    ldflags:
      - -s -w
      - -X github.com/Chaoqun-Guo/ProvidAPT/internal/version.Version={{ .Version }}
    env:
      - CGO_ENABLED=0
    goos:
      - linux
    goarch:
      - amd64
      - arm64

  - id: providapt-deanon
    main: ./cmd/cli/providapt-deanon
    binary: providapt-deanon
    flags:
      - -trimpath
    ldflags:
      - -s -w
      - -X github.com/Chaoqun-Guo/ProvidAPT/internal/version.Version={{ .Version }}
    env:
      - CGO_ENABLED=0
    goos:
      - linux
    goarch:
      - amd64
      - arm64

  - id: providapt-heal
    main: ./cmd/cli/providapt-heal
    binary: providapt-heal
    flags:
      - -trimpath
    ldflags:
      - -s -w
      - -X github.com/Chaoqun-Guo/ProvidAPT/internal/version.Version={{ .Version }}
    env:
      - CGO_ENABLED=0
    goos:
      - linux
    goarch:
      - amd64
      - arm64

  - id: watchdog
    main: ./cmd/agent/watchdog
    binary: providapt-watchdog
    flags:
      - -trimpath
    ldflags:
      - -s -w
      - -X github.com/Chaoqun-Guo/ProvidAPT/internal/version.Version={{ .Version }}
    env:
      - CGO_ENABLED=0
    goos:
      - linux
    goarch:
      - amd64
      - arm64

archives:
  - id: binaries
    formats: [tar.gz]
    name_template: >-
      {{ .ProjectName }}_{{ .Version }}_
      {{- if eq .Os "darwin" }}macOS
      {{- else }}{{ .Os }}{{ end }}_
      {{- .Arch }}
    files:
      - LICENSE
      - README.md
      - CHANGELOG.md

nfpms:
  - id: linux-packages
    package_name: providapt
    file_name_template: "{{ .ProjectName }}_{{ .Version }}_{{ .Arch }}"
    builds:
      - providaptd
      - providaptctl
      - providapt-verify
    vendor: ProvidAPT
    homepage: https://github.com/Chaoqun-Guo/ProvidAPT
    maintainer: ProvidAPT Team <dev@providapt.io>
    description: |
      ProvidAPT — Provenance-driven APT Detection Platform.
      eBPF-based provenance monitoring with automated threat detection.
    license: Apache 2.0
    formats:
      - deb
      - rpm
    bindir: /usr/bin
    contents:
      - src: ./build/providapt.toml
        dst: /etc/providapt/providapt.toml
        type: config
      - src: ./build/prometheus/providapt_alerts.yml
        dst: /etc/providapt/providapt_alerts.yml
      - src: ./build/prometheus/providapt_dashboard.json
        dst: /etc/providapt/providapt_dashboard.json

checksum:
  name_template: "checksums.txt"
  algorithm: sha256

sbom:
  - id: spdx
    documents:
      - name: "{{ .ProjectName }}-{{ .Version }}-spdx"
        output: "{{ .ArtifactName }}.spdx.json"
        format: spdx-json

signs:
  - artifacts: checksum
    args:
      - "--batch"
      - "--local-user"
      - "{{ .Env.GPG_FINGERPRINT }}"
      - "--output"
      - "${signature}"
      - "--detach-sign"
      - "${artifact}"

release:
  github:
    owner: Chaoqun-Guo
    name: ProvidAPT
  prerelease: auto
  header: |
    # ProvidAPT {{ .Version }}

    ## Downloads

    Pre-built binaries for Linux (amd64, arm64) and macOS (amd64, arm64).

    ## Changelog

    See [CHANGELOG.md](CHANGELOG.md) for details.
  footer: |
    ## Verification

    ```sh
    sha256sum -c checksums.txt
    gpg --verify checksums.txt.sig checksums.txt
    ```

changelog:
  use: github-native
