# ProvidAPT development environment — Rocky Linux 9
FROM rockylinux:9

LABEL description="ProvidAPT eBPF development environment (RHEL compatible)"

RUN dnf install -y \
    # Go toolchain
    golang \
    # LLVM/Clang for eBPF compilation
    clang \
    llvm \
    # BPF tooling
    bpftool \
    libbpf-devel \
    # System tools
    kernel-headers \
    kernel-devel \
    curl \
    git \
    make \
    && dnf clean all

WORKDIR /workspace
COPY . .

CMD ["/bin/bash"]
