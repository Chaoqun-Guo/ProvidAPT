[Unit]
Description=ProvidAPT Provenance Monitor (cgroup-limited)
Documentation=https://github.com/Chaoqun-Guo/ProvidAPT
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/providaptctl -status || true
ExecStart=/usr/local/sbin/providaptd
ExecStop=/usr/local/bin/providaptctl -stop
Restart=on-failure
RestartSec=5

# ── Resource limits (cgroup v2) ─────────────────────────
CPUQuota=10%
MemoryMax=512M
MemoryHigh=480M
MemorySwapMax=0

# ── Security hardening ──────────────────────────────────
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_BPF CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_PTRACE
AmbientCapabilities=CAP_BPF CAP_SYS_ADMIN

# ── File locations ──────────────────────────────────────
RuntimeDirectory=providapt
StateDirectory=providapt
LogsDirectory=providapt
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
