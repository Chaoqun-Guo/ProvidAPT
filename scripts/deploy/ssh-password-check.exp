#!/usr/bin/env expect
set timeout 20

if {$argc < 4} {
    puts stderr "usage: ssh-password-check.exp user host password command"
    exit 2
}

set user [lindex $argv 0]
set host [lindex $argv 1]
set pass [lindex $argv 2]
set cmd [lindex $argv 3]

spawn ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$user@$host" "$cmd"
expect {
    -nocase "*password*" {
        send -- "$pass\r"
        exp_continue
    }
    -nocase "*permission denied*" {
        exit 13
    }
    eof {
        catch wait result
        exit [lindex $result 3]
    }
    timeout {
        puts stderr "ssh timed out"
        exit 124
    }
}
