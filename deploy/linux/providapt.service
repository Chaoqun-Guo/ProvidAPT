[Unit]
Description=ProvidAPT provenance monitor
Documentation=https://github.com/Chaoqun-Guo/ProvidAPT
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/default/providapt
ExecStartPre=/usr/bin/test -r /etc/providapt/providapt.toml
ExecStartPre=/usr/bin/test -d /usr/local/lib/providapt/ebpf
ExecStart=/usr/local/sbin/providaptd -config /etc/providapt/providapt.toml ${PROVIDAPT_DAEMON_ARGS}
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10

LimitNOFILE=1048576
LimitMEMLOCK=infinity
TasksMax=8192

RuntimeDirectory=providapt
StateDirectory=providapt
LogsDirectory=providapt
ReadWritePaths=/etc/providapt /var/lib/providapt /var/log/providapt /run/providapt

NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectControlGroups=false
CapabilityBoundingSet=CAP_BPF CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_PTRACE CAP_PERFMON CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_BPF CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_PTRACE CAP_PERFMON CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
