# ProvidAPT service environment.
# This file is loaded by providapt.service when installed to /etc/default/providapt.

# Extra daemon arguments appended to:
#   /usr/local/sbin/providaptd -config /etc/providapt/providapt.toml
PROVIDAPT_DAEMON_ARGS="-log-level=info"

# Override eBPF object when the default search path is not suitable.
PROVIDAPT_BPF_OBJECT_PATH="/usr/local/lib/providapt/ebpf/lsm_hooks.bpf.o"

# Optional testing or degraded-kernel mode. Leave empty in production.
# Example: PROVIDAPT_SKIP_SANITY_CHECKS="bpf_lsm,providapt_user"
PROVIDAPT_SKIP_SANITY_CHECKS=""

# Keep privilege dropping enabled in production. Set to 1 only for lab hosts
# where the providapt system user is intentionally not created.
PROVIDAPT_SKIP_PRIVILEGE_DROP=""
