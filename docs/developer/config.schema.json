{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://providapt.local/schemas/providapt-config.schema.json",
  "title": "ProvidAPT Configuration",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "api": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rest": { "type": "string", "examples": [":8080"] },
        "grpc": { "type": "string", "examples": [":50051"] },
        "auth_enabled": { "type": "boolean" },
        "auth_keys": { "type": "array", "items": { "type": "string" } },
        "auth_roles": { "type": "object", "additionalProperties": { "type": "string" } },
        "auth_tenants": { "type": "object", "additionalProperties": { "type": "string" } },
        "cors_origins": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider": { "type": "string", "enum": ["ollama", "openai"] },
        "endpoint": { "type": "string" },
        "model": { "type": "string" },
        "timeout": { "type": "string", "examples": ["60s"] },
        "max_retries": { "type": "integer", "minimum": 0 },
        "retry_backoff": { "type": "string", "examples": ["250ms"] },
        "circuit_breaker_threshold": { "type": "integer", "minimum": 0 },
        "circuit_breaker_cooldown": { "type": "string", "examples": ["30s"] },
        "max_prompt_bytes": { "type": "integer", "minimum": 0 },
        "fallback_without_llm": { "type": "boolean" }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "include_comms": { "type": "array", "items": { "type": "string" } },
        "detail_level": { "type": "string", "enum": ["minimal", "standard", "full"] }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dir": { "type": "string" },
        "format": { "type": "string", "enum": ["json", "parquet"] },
        "max_file_bytes": { "type": "integer", "minimum": 0 },
        "retain_files": { "type": "integer", "minimum": 0 },
        "retain_max_bytes": { "type": "integer", "minimum": 0 },
        "alert_max_file_bytes": { "type": "integer", "minimum": 0 },
        "alert_retain_files": { "type": "integer", "minimum": 0 },
        "alert_retain_max_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "control_plane": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": { "type": "string", "enum": ["standalone", "active-passive", "external"] },
        "node_id": { "type": "string" },
        "role": { "type": "string", "enum": ["leader", "follower", "observer"] },
        "leader_id": { "type": "string" },
        "peers": { "type": "array", "items": { "type": "string" } },
        "state_backend": {
          "type": "string",
          "description": "local state file path, local, postgres://..., or postgresql://..."
        },
        "heartbeat": { "type": "string" },
        "election_timeout": { "type": "string" }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enable": { "type": "boolean" },
        "cert_file": { "type": "string" },
        "key_file": { "type": "string" },
        "ca_file": { "type": "string" },
        "rotation_check": { "type": "string", "examples": ["24h"] },
        "rotation_renew_before": { "type": "string", "examples": ["720h"] },
        "rotation_auto": { "type": "boolean" },
        "rotation_restart_after": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider": { "type": "string", "enum": ["env", "file", "vault"] },
        "base_dir": { "type": "string" },
        "vault": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "endpoint": { "type": "string" },
        "api_key": { "type": "string" },
        "bundle_dir": { "type": "string" }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "retain_archives": { "type": "integer", "minimum": 1 }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "retention_days": { "type": "integer", "minimum": 1 },
        "require_approvals": { "type": "boolean" }
      }
    },
    "siem": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "enum": ["generic", "splunk", "elastic"] },
        "endpoint": { "type": "string" },
        "token": { "type": "string" },
        "min_severity": { "type": "string" },
        "outbox_dir": { "type": "string" }
      }
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "download_url": { "type": "string" },
        "expected_sha256": { "type": "string" },
        "signature_path": { "type": "string" },
        "apply_command": { "type": "string" },
        "rollback_command": { "type": "string" }
      }
    }
  }
}
